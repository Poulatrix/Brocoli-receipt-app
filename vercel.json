{
  "version": 2,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/households/:action*",
      "destination": "/api/households?__action=:action*"
    },
    {
      "source": "/api/widget/:action*",
      "destination": "/api/widget?__action=:action*&__mode=api"
    },
    {
      "source": "/widget/:action*",
      "destination": "/api/widget?__action=:action*&__mode=html"
    },
    {
      "source": "/((?!api/|widget/|assets/|sw\\.js$|manifest\\.webmanifest$|logo_brocoli\\.jpg$|logo-2\\.png$|icon\\.jpg$|favicon\\.ico$).*)",
      "destination": "/index.html"
    }
  ]
}
